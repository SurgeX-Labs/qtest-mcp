APP_NAME=qtest-mcp-server
APP_ENV=dev
QTEST_BASE_URL=https://your-company.qtestnet.com
QTEST_CLIENT_AUTH_TOKEN=replace-with-qtest-api-sdk-token
JWT_SECRET=replace-with-long-random-secret
FERNET_KEY=replace-with-generated-fernet-key
ALLOWED_ORIGINS=http://localhost:8000
TOKEN_TTL_MINUTES=43200
JWT_ISSUER=qtest-mcp-server
JWT_AUDIENCE=qtest-mcp-clients
MCP_POLICY_FILE=
MCP_POLICY_JSON=
ALLOW_BOT_WRITES=false
DEFAULT_USER_SCOPES=projects:read,requirements:read,requirements:write,testcases:read,testcases:write,testruns:read,defects:read,defects:write
DEFAULT_BOT_SCOPES=projects:read,requirements:read,testcases:read,testruns:read,defects:read
MCP_ADMIN_TOKEN=
